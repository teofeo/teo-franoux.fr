---
import Layout from "@/layouts/Layout.astro";
import ProjectGrid from "@/components/projects/ProjectGrid.astro";
import PageHero from "@/components/page/PageHero.astro";
import InfoGrid from "@/components/page/InfoGrid.astro";

import { FolderGit2, Code2, Layers3 } from "lucide-astro";

const features = [
    {
        icon: FolderGit2,
        label: "Projets",
        title: "Projets personnels & académiques",
    },
    {
        icon: Code2,
        label: "Technologies",
        title: "TypeScript · Docker · Terraform · Ansible",
    },
    {
        icon: Layers3,
        label: "Domaines",
        title: "DevOps · Infrastructure · Réseaux",
    },
];
---

<Layout
    title="Projets - Téo Franoux"
    description="Découvrez les projets personnels et académiques de Téo Franoux autour du développement, du DevOps et de l'infrastructure."
>
    <PageHero
        eyebrow="Mon portfolio"
        title="Projets"
        description="Une sélection de projets personnels et académiques autour du développement, du DevOps, du cloud et de l'infrastructure."
    />

    <InfoGrid features={features} />

    <section class="mx-auto max-w-7xl px-4 py-20 md:py-28">
        <ProjectGrid />
    </section>
</Layout>
