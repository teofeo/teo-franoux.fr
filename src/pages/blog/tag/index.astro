---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/page/PageHero.astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import { slugifyTag } from "@/utils/slugify";

const posts: CollectionEntry<"blog">[] = await getCollection("blog");

const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

const tagsWithCount = tags
    .map((tag) => ({
        name: tag,
        slug: slugifyTag(tag),
        count: posts.filter((post) => post.data.tags.includes(tag)).length,
    }))
    .sort((a, b) => b.count - a.count);
---

<Layout title="Catégories">
    <main>
        <PageHero
            eyebrow="Blog"
            title="Tags"
            description="Explorez les articles par sujet."
        />

        <section class="mx-auto max-w-6xl px-6 py-10">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {tagsWithCount.map((tag) => (
                    <a
                        href={`/blog/tag/${encodeURIComponent(tag.slug)}`}
                        class="group rounded-xl border border-border bg-card p-6 transition-all hover:-translate-y-1 hover:border-primary hover:shadow-lg"
                    >
                        <div class="flex items-center justify-between gap-4">
                            <div>
                                <h2 class="text-lg font-semibold transition-colors group-hover:text-primary">
                                    {tag.name}
                                </h2>

                                <p class="mt-1 text-sm text-muted-foreground">
                                    {tag.count}{" "}
                                    {tag.count === 1 ? "article" : "articles"}
                                </p>
                            </div>

                            <span class="text-xl text-muted-foreground transition-transform group-hover:translate-x-1">
                                →
                            </span>
                        </div>
                    </a>
                ))}
            </div>
        </section>
    </main>
</Layout>
