---
import {
    Server,
    Boxes,
    Workflow,
    Network,
    HardDrive,
    Cpu,
    GitBranch,
    ShieldCheck,
    ExternalLink,
} from "lucide-astro";

import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/page/PageHero.astro";
import InfoGrid from "@/components/page/InfoGrid.astro";

const features = [
    {
        icon: Server,
        label: "Hardware",
        title: "Minisforum MS-A2",
    },
    {
        icon: Boxes,
        label: "Hyperviseur",
        title: "Proxmox VE",
    },
    {
        icon: Workflow,
        label: "Approche",
        title: "Infrastructure as Code",
    },
];
---

<Layout
    title="Homelab - Téo Franoux"
    description="Le homelab de Téo Franoux : Proxmox, réseau, Linux, Terraform, Ansible, Docker et Kubernetes."
>
    <main>
        <PageHero
            eyebrow="homelab/"
            title="Mon terrain d'expérimentation."
            description="Un environnement personnel dans lequel je peux expérimenter librement avec le réseau, les systèmes, la virtualisation, l'automatisation et le DevOps."
        />

        <InfoGrid features={features} />

        <!-- Architecture -->
        <section class="mx-auto max-w-7xl px-4 py-20 md:py-28">
            <div class="mb-12 max-w-2xl">
                <p class="text-sm font-medium text-primary">Architecture</p>

                <h2 class="mt-2 text-3xl font-bold tracking-tight">
                    Une infrastructure que je construis moi-même.
                </h2>

                <p class="mt-4 text-muted-foreground">
                    Le but n'est pas simplement d'héberger quelques services. Je
                    cherche à comprendre chaque couche de l'infrastructure et à
                    automatiser progressivement sa gestion.
                </p>
            </div>

            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
                <!-- Virtualisation -->
                <article class="rounded-xl border border-border p-6">
                    <Server class="size-5" />

                    <h3 class="mt-5 font-semibold">Virtualisation</h3>

                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                        Proxmox constitue la base de mon infrastructure. Je
                        l'utilise pour créer et administrer mes machines
                        virtuelles et mes différents environnements.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Proxmox
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            VM
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            LXC
                        </span>
                    </div>
                </article>

                <!-- Network -->
                <article class="rounded-xl border border-border p-6">
                    <Network class="size-5" />

                    <h3 class="mt-5 font-semibold">Networking</h3>

                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                        Je construis progressivement mon réseau autour du DNS,
                        des VLAN, du routage et des différents composants
                        nécessaires au fonctionnement des services.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            DNS
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            VLAN
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Routing
                        </span>
                    </div>
                </article>

                <!-- Sysadmin -->
                <article class="rounded-xl border border-border p-6">
                    <Cpu class="size-5" />

                    <h3 class="mt-5 font-semibold">Sysadmin</h3>

                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                        Installation, configuration et administration de
                        systèmes Linux et des services qui composent
                        l'infrastructure.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Linux
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Ubuntu
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            SSH
                        </span>
                    </div>
                </article>

                <!-- IaC -->
                <article class="rounded-xl border border-border p-6">
                    <GitBranch class="size-5" />

                    <h3 class="mt-5 font-semibold">Infrastructure as Code</h3>

                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                        Mon objectif est de pouvoir gérer mon infrastructure
                        depuis Git plutôt que de dépendre de configurations
                        manuelles.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Terraform
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Ansible
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Git
                        </span>
                    </div>
                </article>

                <!-- Containers -->
                <article class="rounded-xl border border-border p-6">
                    <Boxes class="size-5" />

                    <h3 class="mt-5 font-semibold">Containers</h3>

                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                        J'expérimente également avec la conteneurisation et
                        l'orchestration pour faire évoluer progressivement mon
                        infrastructure.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Docker
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Kubernetes
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            K3s
                        </span>
                    </div>
                </article>

                <!-- Storage -->
                <article class="rounded-xl border border-border p-6">
                    <HardDrive class="size-5" />

                    <h3 class="mt-5 font-semibold">Storage</h3>

                    <p class="mt-2 text-sm leading-6 text-muted-foreground">
                        Je travaille également sur la gestion du stockage et
                        l'organisation des données nécessaires aux différents
                        services.
                    </p>

                    <div class="mt-5 flex flex-wrap gap-2">
                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Storage
                        </span>

                        <span class="rounded-md bg-muted px-2.5 py-1 font-mono text-xs">
                            Backups
                        </span>
                    </div>
                </article>
            </div>
        </section>

        <!-- IaC -->
        <section class="border-y border-border bg-muted/20">
            <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 md:grid-cols-2 md:items-center md:py-28">
                <div>
                    <p class="text-sm font-medium text-primary">
                        Infrastructure as Code
                    </p>

                    <h2 class="mt-2 text-3xl font-bold tracking-tight">
                        Mon homelab devient progressivement reproductible.
                    </h2>

                    <p class="mt-4 max-w-xl leading-7 text-muted-foreground">
                        L'objectif est de pouvoir partir d'un dépôt Git et
                        reconstruire progressivement l'infrastructure : créer
                        les machines avec Terraform, les configurer avec Ansible
                        puis faire évoluer l'ensemble vers une infrastructure
                        davantage automatisée.
                    </p>
                </div>

                <div class="rounded-xl border border-border bg-background p-6 font-mono text-sm shadow-sm">
                    <div class="flex items-center gap-2 border-b border-border pb-4 text-muted-foreground">
                        <span>~/homelab</span>
                    </div>

                    <div class="space-y-3 pt-5 text-muted-foreground">
                        <p>
                            <span class="text-primary">├──</span>
                            terraform/
                        </p>

                        <p>
                            <span class="text-primary">├──</span>
                            ansible/
                        </p>

                        <p>
                            <span class="text-primary">├──</span>
                            network/
                        </p>

                        <p>
                            <span class="text-primary">├──</span>
                            services/
                        </p>

                        <p>
                            <span class="text-primary">└──</span>
                            README.md
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Security -->
        <section class="mx-auto max-w-7xl px-4 py-20 md:py-28">
            <div class="grid gap-12 md:grid-cols-2">
                <div>
                    <p class="text-sm font-medium text-primary">Philosophie</p>

                    <h2 class="mt-2 text-3xl font-bold tracking-tight">
                        Apprendre en construisant.
                    </h2>
                </div>

                <div class="space-y-6 text-sm leading-7 text-muted-foreground">
                    <p>
                        Mon homelab est avant tout un environnement
                        d'apprentissage. Je peux y tester une architecture, la
                        casser, recommencer et automatiser ce qui fonctionne.
                    </p>

                    <p>
                        Chaque nouveau service est également l'occasion de
                        travailler sur plusieurs couches : réseau, système,
                        sécurité, déploiement et observabilité.
                    </p>

                    <div class="flex gap-4 rounded-xl border border-border p-5">
                        <ShieldCheck class="mt-0.5 size-5 shrink-0 text-primary" />

                        <p>
                            L'objectif n'est pas de construire l'infrastructure
                            la plus complexe possible, mais de comprendre
                            pourquoi elle fonctionne et de pouvoir la
                            reproduire.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="border-t border-border">
            <div class="mx-auto max-w-7xl px-4 py-16 md:py-20">
                <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
                    <div>
                        <p class="font-semibold">
                            Voir les détails de mon infrastructure
                        </p>

                        <p class="mt-1 text-sm text-muted-foreground">
                            Architecture, services et projets en cours.
                        </p>
                    </div>

                    <a
                        href="/blog"
                        class="inline-flex items-center gap-2 rounded-md border border-border px-4 py-2.5 text-sm font-medium transition-colors hover:bg-muted"
                    >
                        Voir les articles
                        <ExternalLink class="size-4" />
                    </a>
                </div>
            </div>
        </section>
    </main>
</Layout>
