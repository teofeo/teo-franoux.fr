---
import {
    Server,
    Terminal,
    Workflow,
    Network,
    Boxes,
    ArrowRight,
} from "lucide-astro";

import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/page/PageHero.astro";
---

<Layout
    title="Homelab - Téo Franoux"
    description="Mon homelab personnel : un environnement pour expérimenter avec l'infrastructure, Linux, le réseau et l'automatisation."
>
    <main>
        <PageHero
            eyebrow="Homelab"
            title="Construire pour comprendre."
            description="Un serveur personnel sur lequel j'expérimente l'infrastructure, les systèmes et l'automatisation."
        />

        <section class="mx-auto max-w-7xl px-4 py-20 md:py-28">
            <div class="grid gap-12 md:grid-cols-2 md:items-end">
                <div>
                    <p class="font-mono text-sm font-medium text-primary">
                        Le matériel
                    </p>

                    <h2 class="mt-2 text-3xl font-bold tracking-tight">
                        Un serveur dédié à l'expérimentation.
                    </h2>

                    <p class="mt-4 leading-7 text-muted-foreground">
                        Le cœur de mon homelab est un Minisforum MS-A2. Une
                        machine suffisamment puissante pour faire tourner
                        plusieurs environnements tout en restant compacte et
                        silencieuse.
                    </p>

                    <div class="mt-8 grid grid-cols-2 gap-4">
                        <div class="rounded-xl border border-border p-5">
                            <p class="font-mono text-2xl font-semibold">16</p>
                            <p class="mt-1 text-sm text-muted-foreground">
                                cœurs CPU
                            </p>
                        </div>

                        <div class="rounded-xl border border-border p-5">
                            <p class="font-mono text-2xl font-semibold">32</p>
                            <p class="mt-1 text-sm text-muted-foreground">
                                threads
                            </p>
                        </div>

                        <div class="rounded-xl border border-border p-5">
                            <p class="font-mono text-2xl font-semibold">
                                96 Go
                            </p>
                            <p class="mt-1 text-sm text-muted-foreground">
                                de RAM
                            </p>
                        </div>

                        <div class="rounded-xl border border-border p-5">
                            <p class="font-mono text-2xl font-semibold">2 To</p>
                            <p class="mt-1 text-sm text-muted-foreground">
                                de stockage
                            </p>
                        </div>
                    </div>
                </div>

                <div class="flex min-h-80 items-center justify-center rounded-2xl border border-border bg-muted/20 p-8">
                    <div class="text-center">
                        <Server class="mx-auto size-12 text-primary" />

                        <p class="mt-5 font-mono text-sm">Minisforum MS-A2</p>

                        <p class="mt-2 text-sm text-muted-foreground">
                            Ryzen 9 9955HX
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <section class="border-y border-border bg-muted/20">
            <div class="mx-auto max-w-7xl px-4 py-20 md:py-28">
                <div class="max-w-2xl">
                    <p class="font-mono text-sm font-medium text-primary">
                        Pourquoi ?
                    </p>

                    <h2 class="mt-2 text-3xl font-bold tracking-tight">
                        Sortir du simple environnement de développement.
                    </h2>

                    <p class="mt-4 leading-7 text-muted-foreground">
                        Un homelab me permet de travailler sur des problèmes que
                        l'on rencontre rarement en développant uniquement sur sa
                        machine : déployer une machine, configurer un service,
                        gérer le réseau ou automatiser une configuration.
                    </p>
                </div>

                <div class="mt-12 grid gap-4 md:grid-cols-3">
                    <article class="rounded-xl border border-border bg-background p-6">
                        <Terminal class="size-5" />

                        <h3 class="mt-5 font-semibold">
                            Comprendre les systèmes
                        </h3>

                        <p class="mt-2 text-sm leading-6 text-muted-foreground">
                            Linux, processus, services, permissions, SSH et
                            fonctionnement des machines.
                        </p>
                    </article>

                    <article class="rounded-xl border border-border bg-background p-6">
                        <Network class="size-5" />

                        <h3 class="mt-5 font-semibold">Comprendre le réseau</h3>

                        <p class="mt-2 text-sm leading-6 text-muted-foreground">
                            Communication entre machines, adressage, DNS et
                            exposition des services.
                        </p>
                    </article>

                    <article class="rounded-xl border border-border bg-background p-6">
                        <Workflow class="size-5" />

                        <h3 class="mt-5 font-semibold">Automatiser</h3>

                        <p class="mt-2 text-sm leading-6 text-muted-foreground">
                            Remplacer progressivement les opérations manuelles
                            par du code versionné et reproductible.
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-4 py-20 md:py-28">
            <div class="mb-12 max-w-2xl">
                <p class="font-mono text-sm font-medium text-primary">
                    Expérimentations
                </p>

                <h2 class="mt-2 text-3xl font-bold tracking-tight">
                    Des problèmes concrets plutôt qu'une collection d'outils.
                </h2>

                <p class="mt-4 text-muted-foreground">
                    Chaque ajout au homelab part d'un besoin ou d'une question
                    que je veux résoudre.
                </p>
            </div>

            <div class="space-y-4">
                <article class="group flex flex-col gap-6 rounded-xl border border-border p-6 md:flex-row md:items-center md:justify-between">
                    <div class="flex gap-5">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                            <Server class="size-5" />
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Déployer une nouvelle machine
                            </h3>

                            <p class="mt-1 text-sm text-muted-foreground">
                                Créer et configurer des machines virtuelles sans
                                refaire manuellement chaque étape.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
                        Proxmox · Terraform · Ansible
                    </div>
                </article>

                <article class="group flex flex-col gap-6 rounded-xl border border-border p-6 md:flex-row md:items-center md:justify-between">
                    <div class="flex gap-5">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                            <Network class="size-5" />
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Donner des noms aux machines
                            </h3>

                            <p class="mt-1 text-sm text-muted-foreground">
                                Mettre en place un réseau interne où les
                                machines et services sont accessibles par leur
                                nom plutôt que par leur adresse IP.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
                        DNS · Réseau
                    </div>
                </article>

                <article class="group flex flex-col gap-6 rounded-xl border border-border p-6 md:flex-row md:items-center md:justify-between">
                    <div class="flex gap-5">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                            <Boxes class="size-5" />
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Expérimenter avec les conteneurs
                            </h3>

                            <p class="mt-1 text-sm text-muted-foreground">
                                Comprendre comment déployer et faire évoluer des
                                applications conteneurisées.
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2 font-mono text-xs text-muted-foreground">
                        Docker · K3s
                    </div>
                </article>
            </div>
        </section>

        <!-- Workflow -->
        <section class="border-y border-border bg-muted/20">
            <div class="mx-auto max-w-7xl px-4 py-20 md:py-28">
                <div class="grid gap-12 md:grid-cols-2 md:items-center">
                    <div>
                        <p class="font-mono text-sm font-medium text-primary">
                            Méthode
                        </p>

                        <h2 class="mt-2 text-3xl font-bold tracking-tight">
                            Expérimenter. Automatiser. Recommencer.
                        </h2>

                        <p class="mt-4 leading-7 text-muted-foreground">
                            Le homelab n'a pas vocation à être parfait. Il
                            évolue au fur et à mesure de mes expérimentations et
                            de ce que j'apprends.
                        </p>
                    </div>

                    <div class="space-y-3">
                        <div class="flex items-center gap-4 rounded-xl border border-border bg-background p-5">
                            <span class="font-mono text-sm text-primary">
                                01
                            </span>

                            <span class="font-medium">Tester une idée</span>
                        </div>

                        <div class="flex items-center gap-4 rounded-xl border border-border bg-background p-5">
                            <span class="font-mono text-sm text-primary">
                                02
                            </span>

                            <span class="font-medium">
                                Comprendre ce qui se passe
                            </span>
                        </div>

                        <div class="flex items-center gap-4 rounded-xl border border-border bg-background p-5">
                            <span class="font-mono text-sm text-primary">
                                03
                            </span>

                            <span class="font-medium">
                                Automatiser ce qui fonctionne
                            </span>
                        </div>

                        <div class="flex items-center gap-4 rounded-xl border border-border bg-background p-5">
                            <span class="font-mono text-sm text-primary">
                                04
                            </span>

                            <span class="font-medium">
                                Repartir de zéro si nécessaire
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
</Layout>
