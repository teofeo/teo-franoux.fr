---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Contact — Téo Franoux" description="Contacter Téo Franoux.">
    <section class="mx-auto max-w-screen-2xl px-4 py-20">
        <div class="max-w-2xl">
            <p class="text-sm font-medium text-muted-foreground">Contact</p>

            <h1 class="mt-2 text-4xl font-bold tracking-tight">Me contacter</h1>

            <p class="mt-6 text-lg text-muted-foreground">
                Une question, un projet ou simplement envie d'échanger ?
                N'hésite pas à me contacter.
            </p>

            <div class="mt-10">
                <a
                    href="mailto:ton@email.com"
                    class="font-medium underline underline-offset-4"
                >
                    ton@email.com
                </a>
            </div>
        </div>
    </section>
</Layout>
