---
import AboutTimeline from "@/components/about/AboutTimeline.astro";
---

<section id="about" class="border-y border-border bg-muted/20">
    <div class="mx-auto max-w-7xl px-4 my-20 md:my-28">
        <div class="mb-10 max-w-2xl">
            <p class="text-sm text-primary">La timeline/</p>

            <h3 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl">
                De l'informatique au DevOps.
            </h3>

            <p class="mt-4 text-muted-foreground">
                Un parcours construit progressivement, du développement logiciel
                vers l'infrastructure, l'automatisation et le Cloud Native.
            </p>
        </div>

        <AboutTimeline />
    </div>
</section>
