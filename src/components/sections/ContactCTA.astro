---
import { Mail, ArrowUpRight } from "lucide-astro";
---

<section class="mx-auto max-w-7xl px-4 py-16 md:py-24">
    <div class="relative overflow-hidden rounded-2xl border border-border bg-linear-to-br from-muted/50 via-background to-background p-8 md:p-12 shadow-soft hover:shadow-glow transition-smooth">
        <!-- Effet de gradient en arrière-plan -->
        <div class="absolute inset-0 bg-linear-to-br from-primary/10 via-transparent to-transparent opacity-50 pointer-events-none"></div>

        <div class="relative z-10 mx-auto max-w-3xl text-center">
            <div class="inline-flex items-center justify-center size-16 rounded-full bg-primary/10 mb-6 animate-fade-up">
                <Mail class="size-8 text-primary" />
            </div>

            <h2 class="text-3xl font-bold tracking-tight md:text-4xl animate-fade-up animation-delay-100">
                Travaillons ensemble
            </h2>

            <p class="mt-4 text-lg text-muted-foreground animate-fade-up animation-delay-200">
                Je suis toujours ouvert à de nouveaux projets, collaborations ou
                discussions autour du DevOps et de l'infrastructure.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-4 animate-fade-up animation-delay-300">
                <a
                    href="/contact"
                    class="group relative overflow-hidden rounded-md bg-primary px-6 py-3 text-sm font-medium text-primary-foreground shadow-soft transition-smooth hover:shadow-glow hover:scale-105"
                >
                    <span class="relative z-10 flex items-center gap-2">
                        Me contacter
                        <ArrowUpRight class="size-4 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                    </span>
                    <div class="absolute inset-0 z-0 bg-linear-to-r from-transparent via-white/20 to-transparent translate-x-[-200%] group-hover:translate-x-[200%] transition-transform duration-700"></div>
                </a>

                <a
                    href="mailto:teo.franoux@epitech.eu"
                    class="rounded-md border border-border px-6 py-3 text-sm font-medium transition-smooth hover:bg-accent hover:border-primary/50 hover:scale-105 shadow-soft"
                >
                    Envoyer un email
                </a>
            </div>
        </div>
    </div>
</section>
