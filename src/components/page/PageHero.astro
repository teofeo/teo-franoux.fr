---
interface Props {
    eyebrow: string;
    title: string;
    description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 pb-16 pt-16 md:pb-24 md:pt-24">
    <div class="mt-10 max-w-4xl">
        <p class="font-mono text-sm text-primary">
            {eyebrow}
        </p>

        <h1
            class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl md:text-6xl"
        >
            {title}
        </h1>

        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">
            {description}
        </p>
    </div>
</section>
