---
const { post } = Astro.props;
---

<article
    class="group rounded-xl border border-border p-6 transition-colors hover:bg-muted/50"
>
    <a href={`/blog/${post.id}`} class="block">
        <div class="flex items-center gap-3 text-sm text-muted-foreground">
            <time datetime={post.data.pubDate.toISOString()}>
                {
                    post.data.pubDate.toLocaleDateString("fr-FR", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                    })
                }
            </time>
        </div>

        <h3
            class="mt-3 text-xl font-semibold tracking-tight group-hover:text-primary"
        >
            {post.data.title}
        </h3>

        <p class="mt-2 text-muted-foreground">
            {post.data.description}
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
            {
                post.data.tags.map((tag) => (
                    <span class="rounded-md bg-muted px-2 py-1 text-xs">
                        {tag}
                    </span>
                ))
            }
        </div>
    </a>
</article>
