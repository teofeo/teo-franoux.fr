---
import { socialLinks, authorInfo } from "@/config/social";

interface Props {
    showAuthorInfo?: boolean;
}

const { showAuthorInfo = true } = Astro.props;
---

<div class="mt-16 border-t border-border pt-8">
    {showAuthorInfo && (
        <div class="mb-8 flex items-start gap-4">
            {authorInfo.avatar && (
                <img
                    src={authorInfo.avatar}
                    alt={authorInfo.name}
                    class="w-16 h-16 rounded-full object-cover"
                />
            )}
            <div>
                <h3 class="text-xl font-semibold mb-2">À propos de l'auteur</h3>
                <p class="text-muted-foreground">{authorInfo.bio}</p>
            </div>
        </div>
    )}

    <div class="space-y-4">
        <h4 class="text-lg font-medium">Me suivre</h4>

        <div class="flex flex-wrap gap-3">
            <!-- LinkedIn -->
            {socialLinks.linkedin.show && (
                <a
                    href={socialLinks.linkedin.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#0077B5] hover:bg-[#006399] text-white transition-colors duration-200"
                >
                    <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
                    </svg>
                    <span>{socialLinks.linkedin.label}</span>
                </a>
            )}

            <!-- GitHub -->
            {socialLinks.github.show && (
                <a
                    href={socialLinks.github.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-800 hover:bg-gray-700 text-white transition-colors duration-200"
                >
                    <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                            clip-rule="evenodd"
                        />
                    </svg>
                    <span>{socialLinks.github.label}</span>
                </a>
            )}

            <!-- Twitter/X -->
            {socialLinks.twitter.show && (
                <a
                    href={socialLinks.twitter.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-black hover:bg-gray-900 text-white transition-colors duration-200"
                >
                    <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                    <span>{socialLinks.twitter.label}</span>
                </a>
            )}

            <!-- Email -->
            {socialLinks.email.show && (
                <a
                    href={socialLinks.email.url}
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary hover:bg-primary/90 text-primary-foreground transition-colors duration-200"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        />
                    </svg>
                    <span>{socialLinks.email.label}</span>
                </a>
            )}

            <!-- GitLab (si activé) -->
            {socialLinks.gitlab?.show && (
                <a
                    href={socialLinks.gitlab.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#FC6D26] hover:bg-[#E24329] text-white transition-colors duration-200"
                >
                    <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M23.546 10.93L13.067.452c-.604-.603-1.582-.603-2.188 0L.396 10.931c-.528.53-.528 1.387 0 1.916l10.48 10.479c.604.604 1.582.604 2.186 0l10.48-10.479c.53-.529.53-1.387.004-1.917zm-11.544 9.862L2.828 11.616 12 2.444l9.176 9.172-9.174 9.176z" />
                    </svg>
                    <span>{socialLinks.gitlab.label}</span>
                </a>
            )}

            <!-- Mastodon (si activé) -->
            {socialLinks.mastodon?.show && (
                <a
                    href={socialLinks.mastodon.url}
                    target="_blank"
                    rel="noopener noreferrer me"
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-[#6364FF] hover:bg-[#563ACC] text-white transition-colors duration-200"
                >
                    <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.545c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054c1.517.363 3.072.546 4.632.546.376 0 .75 0 1.125-.01 1.57-.044 3.224-.124 4.768-.422.038-.008.077-.015.11-.024 2.435-.464 4.753-1.92 4.989-5.604.008-.145.03-1.52.03-1.67.002-.512.167-3.63-.024-5.545zm-3.748 9.195h-2.561V8.29c0-1.309-.55-1.976-1.67-1.976-1.23 0-1.846.79-1.846 2.35v3.403h-2.546V8.663c0-1.56-.617-2.35-1.848-2.35-1.112 0-1.668.668-1.67 1.977v6.218H4.822V8.102c0-1.31.337-2.35 1.011-3.12.696-.77 1.608-1.164 2.74-1.164 1.311 0 2.302.5 2.962 1.498l.638 1.06.638-1.06c.66-.999 1.65-1.498 2.96-1.498 1.13 0 2.043.395 2.74 1.164.675.77 1.012 1.81 1.012 3.12z" />
                    </svg>
                    <span>{socialLinks.mastodon.label}</span>
                </a>
            )}
        </div>
    </div>
</div>
