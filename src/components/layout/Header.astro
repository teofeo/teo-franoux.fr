---
import Logo from "./Logo.astro";
import DesktopNav from "./DesktopNav.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header
    class="sticky top-0 z-50 w-full border-b border-border/60 bg-background/80 backdrop-blur-xl"
>
    <div
        class="mx-auto flex h-16 max-w-screen-2xl items-center justify-between px-4 sm:px-6 lg:px-8"
    >
        <Logo />

        <div class="hidden items-center gap-8 md:flex">
            <DesktopNav />

            <div class="h-5 w-px bg-border"></div>

            <ThemeToggle />
        </div>

        <div class="flex items-center gap-2 md:hidden">
            <ThemeToggle />

        </div>
    </div>
</header>
