---
import { navigation } from "@/config/navigation";
---

<nav
    class="fixed bottom-0 left-0 z-50 w-full border-t border-border bg-background/95 p-2 backdrop-blur md:hidden"
    aria-label="Navigation mobile"
>
    <div class="mx-auto flex h-16 max-w-screen-sm items-center justify-between">
        {
            navigation.map((item) => {
                const Icon = item.icon;

                const isActive =
                    item.href === "/"
                        ? Astro.url.pathname === "/"
                        : Astro.url.pathname.startsWith(item.href);

                return (
                    <a
                        href={item.href}
                        aria-label={item.label}
                        aria-current={isActive ? "page" : undefined}
                        class:list={[
                            "relative flex min-h-12 w-full flex-col items-center justify-center transition-colors duration-200",
                            isActive
                                ? "font-semibold text-primary"
                                : "text-muted-foreground hover:text-foreground",
                        ]}
                    >
                        <span
                            class:list={[
                                "flex size-9 items-center justify-center rounded-full transition",
                                isActive ? "bg-primary/10" : "bg-transparent",
                            ]}
                        >
                            <Icon class="size-5" />
                        </span>

                        <span class="max-w-[90%] truncate text-center text-[10px] leading-tight">
                            {item.label}
                        </span>

                        {isActive && (
                            <span class="absolute -bottom-2 left-1/2 h-1 w-6 -translate-x-1/2 rounded-full bg-primary" />
                        )}
                    </a>
                );
            })
        }
    </div>
</nav>
